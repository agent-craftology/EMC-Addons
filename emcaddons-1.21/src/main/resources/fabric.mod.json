{
	"schemaVersion": 1,
	"id": "emcaddons",
	"version": "${version}",
	"name": "EMC Addons",
	"description": "Free public EMC HUD, stats cards, and config GUI",
	"authors": [
		"Craftology Inc"
	],
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.emcaddons.EmcAddons"
		],
		"client": [
			"com.emcaddons.EmcAddonsClient"
		]
	},
	"mixins": [
		"emcaddons.mixins.json",
		{
			"config": "emcaddons.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.14.0",
		"minecraft": "~1.21",
		"java": ">=21",
		"fabric-api": "*"
	}
}
